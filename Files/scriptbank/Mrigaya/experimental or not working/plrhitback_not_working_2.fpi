;Header

desc = Player HitBack Effect on damage (both health and armour)

;Triggers

:state=0:dimvar=A,dimvar=H,dimlocalvar=X,dimlocalvar=Y,dimlocalvar=Z,plrwobble=1,camfov=15,state=1	
:state=1,plralive=1:setvar=A $ARM,setvar=H $PH,plrwobble=1,camfov=15,state=2	
:state=1,plralive=0:state=1

:state=2,vargreater=A $ARM,varnotequal=$ARM 0:state=4
:state=2,vargreater=H $PH,varequal=$ARM 0:state=5
:state=2,varequal=$ARM 0:state=1

:state=3,varless=A $ARM:state=1
:state=3,varless=H $PH:state=1
:state=3,varequal=$PH 0:state=1

:state=4:setvarrnd=X 2,etimerstart,plrwobble=200,camfov=5
:state=4,etimergreater=100,varequal=X 0:plrsound=audiobank\voices\player\bullethit0.wav
:state=4,etimergreater=100,varequal=X 1:plrsound=audiobank\voices\player\bullethit1.wav
:state=4,etimergreater=100,varequal=X 2:plrsound=audiobank\voices\player\bullethit2.wav
:state=4,etimergreater=150,varnotequal=$ARM 0:state=3
	
:state=5:setvarrnd=Y 2,setvarrnd=Z 2,etimerstart,plrwobble=500,camfov=5
:state=5,etimergreater=100,varequal=Y 0:plrsound=audiobank\voices\player\bullethit0.wav
:state=5,etimergreater=100,varequal=Y 1:plrsound=audiobank\voices\player\bullethit1.wav
:state=5,etimergreater=100,varequal=Y 2:plrsound=audiobank\voices\player\bullethit2.wav
:state=5,etimergreater=200,varequal=Z 0:plrsound=audiobank\voices\player\scream0.wav,plrwobble=1,camfov=15
:state=5,etimergreater=200,varequal=Z 1:plrsound=audiobank\voices\player\scream1.wav,plrwobble=1,camfov=15
:state=5,etimergreater=200,varequal=Z 2:plrsound=audiobank\voices\player\scream2.wav,plrwobble=1,camfov=15,state=3

;End of Script